/* =========================================================
   University of Basel — Qt Style Sheet (Light)
   Palette source: Universitat Basel Brand Guideline v2.1
     Mint       #A5D7D2
     Mint hover #7CC2BB
     Red        #D20537   (alerts / destructive only)
     Anthracite #2D373C   (primary text / chrome)
     Grey text  #666666
     Border     #D8E2E0
     Surface    #FFFFFF
     Backdrop   #F4F6F5
   Fonts: Helvetica Neue / Arial (Univers substitute),
          Georgia (Swift Neue substitute, headings only)
   ========================================================= */

* {
    font-family: "Helvetica Neue", Arial, sans-serif;
    font-size: 13px;
    color: #2D373C;
    outline: none;
}

QMainWindow, QDialog, QWidget {
    background-color: #F4F6F5;
}

/* ---------- Menu bar / menus ---------- */
QMenuBar {
    background-color: #FFFFFF;
    border-bottom: 1px solid #D8E2E0;
    padding: 2px 4px;
}
QMenuBar::item {
    background: transparent;
    padding: 6px 10px;
    border-radius: 6px;
}
QMenuBar::item:selected {
    background-color: #A5D7D2;
    color: #2D373C;
}
QMenu {
    background-color: #FFFFFF;
    border: 1px solid #D8E2E0;
    padding: 4px;
}
QMenu::item {
    padding: 6px 24px 6px 12px;
    border-radius: 6px;
}
QMenu::item:selected {
    background-color: #A5D7D2;
    color: #2D373C;
}
QMenu::separator {
    height: 1px;
    background: #D8E2E0;
    margin: 4px 6px;
}

/* ---------- Toolbar ---------- */
QToolBar {
    background-color: #FFFFFF;
    border-bottom: 1px solid #D8E2E0;
    spacing: 4px;
    padding: 4px;
}
QToolButton {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 5px;
}
QToolButton:hover {
    background-color: #EAF4F2;
    border: 1px solid #A5D7D2;
}
QToolButton:pressed, QToolButton:checked {
    background-color: #A5D7D2;
}

/* ---------- Buttons ---------- */
QPushButton {
    background-color: #FFFFFF;
    border: 1px solid #B9C6C4;
    border-radius: 6px;
    padding: 6px 16px;
    min-height: 20px;
}
QPushButton:hover {
    border-color: #7CC2BB;
    background-color: #EAF4F2;
}
QPushButton:pressed {
    background-color: #A5D7D2;
}
QPushButton:disabled {
    color: #999999;
    background-color: #F4F6F5;
    border-color: #E1E6E5;
}
QPushButton:default {
    background-color: #A5D7D2;
    border-color: #7CC2BB;
    font-weight: 600;
}
QPushButton:default:hover {
    background-color: #7CC2BB;
}
QPushButton[destructive="true"] {
    border-color: #D20537;
    color: #D20537;
}
QPushButton[destructive="true"]:hover {
    background-color: #FBE4E9;
}

/* ---------- Inputs ---------- */
QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox, QDoubleSpinBox, QComboBox {
    background-color: #FFFFFF;
    border: 1px solid #B9C6C4;
    border-radius: 6px;
    padding: 4px 6px;
    selection-background-color: #A5D7D2;
    selection-color: #2D373C;
}
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus,
QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus {
    border: 1px solid #2D373C;
}
QLineEdit:disabled, QTextEdit:disabled, QComboBox:disabled {
    background-color: #F4F6F5;
    color: #999999;
}
QLineEdit[error="true"] {
    border: 1px solid #D20537;
}

QComboBox::drop-down {
    border-left: 1px solid #B9C6C4;
    width: 22px;
}
QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    border: 1px solid #D8E2E0;
    selection-background-color: #A5D7D2;
    selection-color: #2D373C;
    outline: none;
}

/* ---------- Checkbox / Radio ---------- */
QCheckBox::indicator, QRadioButton::indicator {
    width: 15px;
    height: 15px;
    border: 1px solid #B9C6C4;
    background: #FFFFFF;
}
QCheckBox::indicator { border-radius: 6px; }
QRadioButton::indicator { border-radius: 8px; }
QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background-color: #A5D7D2;
    border-color: #7CC2BB;
}
QCheckBox::indicator:hover, QRadioButton::indicator:hover {
    border-color: #7CC2BB;
}

/* ---------- Tabs ---------- */
QTabWidget::pane {
    border: 1px solid #D8E2E0;
    background: #FFFFFF;
    top: -1px;
}
QTabBar::tab {
    background: #F4F6F5;
    border: 1px solid #D8E2E0;
    border-bottom: none;
    padding: 6px 16px;
    margin-right: 2px;
    color: #666666;
}
QTabBar::tab:selected {
    background: #FFFFFF;
    color: #2D373C;
    border-top: 2px solid #A5D7D2;
    font-weight: 600;
}
QTabBar::tab:hover:!selected {
    background: #EAF4F2;
}

/* ---------- Tables / Trees / Lists ---------- */
QTableView, QTreeView, QListView {
    background-color: #FFFFFF;
    alternate-background-color: #F4F6F5;
    border: 1px solid #D8E2E0;
    gridline-color: #E7ECEB;
    selection-background-color: #A5D7D2;
    selection-color: #2D373C;
}
QHeaderView::section {
    background-color: #F4F6F5;
    color: #2D373C;
    border: none;
    border-right: 1px solid #D8E2E0;
    border-bottom: 1px solid #D8E2E0;
    padding: 6px 8px;
    font-weight: 600;
}
QTreeView::item:selected, QTableView::item:selected, QListView::item:selected {
    background-color: #A5D7D2;
    color: #2D373C;
}
QTreeView::branch {
    background: transparent;
}

/* ---------- Scrollbars ---------- */
QScrollBar:vertical {
    background: #F4F6F5;
    width: 12px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: #C7D3D1;
    border-radius: 6px;
    min-height: 24px;
}
QScrollBar::handle:vertical:hover { background: #A5D7D2; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar:horizontal {
    background: #F4F6F5;
    height: 12px;
    margin: 0;
}
QScrollBar::handle:horizontal {
    background: #C7D3D1;
    border-radius: 6px;
    min-width: 24px;
}
QScrollBar::handle:horizontal:hover { background: #A5D7D2; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }

/* ---------- Tooltip ---------- */
QToolTip {
    background-color: #2D373C;
    color: #FFFFFF;
    border: 1px solid #2D373C;
    padding: 5px 8px;
    border-radius: 6px;
}

/* ---------- Slider / Progress ---------- */
QSlider::groove:horizontal {
    height: 4px;
    background: #D8E2E0;
    border-radius: 6px;
}
QSlider::handle:horizontal {
    background: #2D373C;
    width: 14px;
    height: 14px;
    margin: -6px 0;
    border-radius: 7px;
}
QSlider::handle:horizontal:hover { background: #A5D7D2; }
QSlider::sub-page:horizontal { background: #A5D7D2; border-radius: 6px; }

QProgressBar {
    background: #E7ECEB;
    border: none;
    border-radius: 6px;
    text-align: center;
    color: #2D373C;
    height: 14px;
}
QProgressBar::chunk {
    background-color: #A5D7D2;
    border-radius: 6px;
}

/* ---------- Group box / Frames ---------- */
QGroupBox {
    border: 1px solid #D8E2E0;
    border-radius: 6px;
    margin-top: 10px;
    padding-top: 12px;
    font-family: Georgia, "Times New Roman", serif;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 8px;
    padding: 0 4px;
    color: #2D373C;
}
QFrame[frameShape="4"], QFrame[frameShape="5"] { /* HLine / VLine */
    color: #D8E2E0;
}

/* ---------- Status bar / Dock / Splitter ---------- */
QStatusBar {
    background: #FFFFFF;
    border-top: 1px solid #D8E2E0;
    color: #666666;
}
QDockWidget {
    titlebar-close-icon: none;
    color: #2D373C;
}
QDockWidget::title {
    background: #F4F6F5;
    border-bottom: 1px solid #D8E2E0;
    padding: 6px;
    font-weight: 600;
}
QSplitter::handle {
    background: #D8E2E0;
}
QSplitter::handle:hover {
    background: #A5D7D2;
}

QLabel[heading="true"] {
    font-family: Georgia, "Times New Roman", serif;
    font-size: 18px;
    color: #2D373C;
}
